{
  "name": "opencode-math-copilot",
  "version": "0.4.0",
  "private": true,
  "description": "OpenCode V2 plugin that turns the OpenAI math repository into searchable, readable, Lean-verifiable tools.",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    ".opencode/plugins",
    ".opencode/skills",
    ".opencode/commands",
    "docker",
    "docs",
    "scripts/lean-docker.ps1",
    "scripts/setup-lean.ps1",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/userbox020/opencode-math-copilot.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bench": "node bench/run.mjs",
    "bench:analyze": "node bench/analyze.mjs",
    "dashboard": "node bench/v2/free-models/build-dashboard.mjs",
    "dashboard:serve": "node bench/v2/free-models/serve-dashboard.mjs",
    "live": "node bench/v2/free-models/build-live.mjs",
    "status:models": "node bench/v2/free-models/build-status-report.mjs",
    "scores:report": "node bench/v2/free-models/build-score-report.mjs",
    "normal:run": "node bench/v3/normal-use/run-normal.mjs",
    "normal:report": "node bench/v3/normal-use/report-normal.mjs",
    "normal:page": "node bench/v3/normal-use/build-normal-page.mjs",
    "normal:test": "node --test bench/v3/normal-use/tests/normal.test.mjs",
    "v4:test": "node --test bench/v4/real-use/tests/tasks.test.mjs bench/v4/real-use/tests/snapshot.test.mjs bench/v4/real-use/tests/runtime-tools.test.mjs bench/v4/real-use/tests/report.test.mjs bench/v4/real-use/tests/real-use.test.mjs bench/v4/real-use/tests/profiles.test.mjs bench/v4/real-use/tests/native-completion.test.mjs bench/v4/real-use/tests/launch.test.mjs bench/v4/real-use/tests/grade-adapter.test.mjs bench/v4/real-use/tests/execution.test.mjs bench/v4/real-use/tests/bridge.test.mjs bench/v4/real-use/tests/finalization-attribution.test.mjs bench/v4/real-use/tests/lineage.test.mjs bench/v4/real-use/tests/checker-smoke.test.mjs bench/v4/real-use/tests/mask-policy.test.mjs bench/v4/real-use/tests/excerpt-snapshots.test.mjs bench/v4/real-use/tests/arxiv-snapshot.test.mjs bench/v4/arxivlean-checker/tests/policies.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "index": "node .opencode/plugins/math-toolkit/scripts/build-index.mjs",
    "index:lean": "node .opencode/plugins/math-toolkit/scripts/build-lean-index.mjs",
    "index:pdf": "node .opencode/plugins/math-toolkit/scripts/build-pdf-index.mjs",
    "test": "node .opencode/plugins/math-toolkit/scripts/test-tools.mjs",
    "v5:test": "node --test bench/v5/external/tests/external.test.mjs bench/v5/packs/matharena-2026/tests/matharena-pack.test.mjs bench/v5/packs/imo-answerbench-v2/tests/imo-pack.test.mjs bench/v5/packs/mathconstruct/tests/mathconstruct-pack.test.mjs bench/v5/comparator/tests/comparator-pack.test.mjs bench/v5/tool-tests/checker-coverage.test.mjs bench/v5/tool-tests/compute-policy.test.mjs bench/v5/tool-tests/compute-worker.test.mjs bench/v5/tool-tests/diagnostics.test.mjs bench/v5/tool-tests/retrieval.test.mjs bench/v5/packs/proofnet-verified/tests/proofnet-pack.test.mjs bench/v5/packs/arxivmath/tests/arxivmath-pack.test.mjs bench/v5/packs/mathconstruct/validator/validator.test.mjs bench/v5/external/tests/symbolic-equiv.test.mjs bench/v5/external/tests/analyze.test.mjs bench/v5/packs/mathconstruct/tests/validator-runner.test.mjs"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.29"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.29"
  },
  "dependencies": {
    "unpdf": "^2.1.0"
  }
}
